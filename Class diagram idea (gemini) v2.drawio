        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class LandlordAccount {\n        +int accountId\n        +String username\n        +String passwordHash\n        +String email\n        +login()\n        +resetPassword()\n    }\n\n    class Property {\n        +int propertyId\n        +int accountId\n        +String name\n        +String address\n        +getTotalUnits()\n    }\n    \n    class Unit {\n        +int unitId\n        +int propertyId\n        +String unitNumber\n        +boolean isOccupied\n        +markOccupied()\n        +markVacant()\n    }\n    \n    class Tenant {\n        +int tenantId\n        +String firstName\n        +String lastName\n        +String phone\n        +String email\n        +String emergencyContact\n        +boolean isActive\n        +updateContactInfo()\n    }\n\n    class Lease {\n        +int leaseId\n        +int unitId\n        +int tenantId\n        +Date startDate\n        +Date endDate\n        +double rentAmount\n        +double securityDeposit\n        +boolean isActive\n        +terminateLease()\n        +renewLease()\n    }\n    \n    class Invoice {\n        +int invoiceId\n        +int leaseId\n        +String billingMonth\n        +double rentCharge\n        +double utilityCharge\n        +double previousBalance\n        +double totalDue\n        +boolean isPaid\n        +calculateTotalDue()\n    }\n    \n    class Payment {\n        +int paymentId\n        +int invoiceId\n        +double amountPaid\n        +Date paymentDate\n        +String paymentMethod\n        +processPayment()\n    }\n\n    class MaintenanceTicket {\n        +int ticketId\n        +int unitId\n        +String issueDescription\n        +Date reportedDate\n        +String status\n        +markResolved()\n    }\n    \n    class Expense {\n        +int expenseId\n        +int propertyId\n        +int ticketId\n        +String description\n        +double amount\n        +Date expenseDate\n        +logExpense()\n    }\n\n    %% Relationships\n    LandlordAccount \&quot;1\&quot; -- \&quot;*\&quot; Property : owns\n    Property \&quot;1\&quot; *-- \&quot;*\&quot; Unit : contains\n    Property \&quot;1\&quot; -- \&quot;*\&quot; Expense : has\n    Unit \&quot;1\&quot; -- \&quot;*\&quot; Lease : has history of\n    Tenant \&quot;1\&quot; -- \&quot;*\&quot; Lease : signs\n    Lease \&quot;1\&quot; *-- \&quot;*\&quot; Invoice : generates\n    Invoice \&quot;1\&quot; *-- \&quot;*\&quot; Payment : receives\n    Unit \&quot;1\&quot; -- \&quot;*\&quot; MaintenanceTicket : reports\n    MaintenanceTicket \&quot;0..1\&quot; -- \&quot;0..1\&quot; Expense : results in&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ddn_Rn-S-M5hbd5OWkgP-74">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
