        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Property {\n        +int propertyId\n        +String name\n        +String address\n        +getTotalUnits()\n        +calculateRevenue()\n    }\n    \n    class Unit {\n        +int unitId\n        +int propertyId\n        +String unitNumber\n        +double baseRent\n        +boolean isOccupied\n        +markOccupied()\n        +markVacant()\n    }\n    \n    class Tenant {\n        +int tenantId\n        +int unitId\n        +String firstName\n        +String lastName\n        +String phone\n        +Date moveInDate\n        +boolean isActive\n        +updateContactInfo()\n    }\n    \n    class Invoice {\n        +int invoiceId\n        +int tenantId\n        +String billingMonth\n        +double baseRent\n        +double utilitySplit\n        +double previousBalance\n        +double totalDue\n        +boolean isPaid\n        +calculateTotalDue()\n        +generatePDF()\n    }\n    \n    class Payment {\n        +int paymentId\n        +int invoiceId\n        +double amountPaid\n        +Date paymentDate\n        +processPayment()\n    }\n    \n    class Expense {\n        +int expenseId\n        +int propertyId\n        +int unitId\n        +String description\n        +double amount\n        +Date expenseDate\n        +logExpense()\n    }\n\n    %% Relationships\n    Property \&quot;1\&quot; *-- \&quot;*\&quot; Unit : contains\n    Property \&quot;1\&quot; -- \&quot;*\&quot; Expense : has\n    Unit \&quot;1\&quot; o-- \&quot;0..1\&quot; Tenant : houses\n    Unit \&quot;1\&quot; -- \&quot;*\&quot; Expense : has (optional)\n    Tenant \&quot;1\&quot; *-- \&quot;*\&quot; Invoice : receives\n    Invoice \&quot;1\&quot; *-- \&quot;*\&quot; Payment : receives&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ddn_Rn-S-M5hbd5OWkgP-1">
