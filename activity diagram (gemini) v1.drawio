<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="uGnek1PrxLRMnXDZP6Rn">
    <mxGraphModel dx="1624" dy="975" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Main Entry Point\n    Start([System Boot]) --&gt; Login(Landlord Logs In)\n    Login --&gt; Dashboard{Main Dashboard:&lt;br&gt;Waiting for Action}\n\n    %% ==========================================\n    %% BRANCH 1: TENANT ONBOARDING (MOVE-IN)\n    %% ==========================================\n    Dashboard --&gt;|Clicks Add Tenant| Onboard1(Enter Tenant Details)\n    Onboard1 --&gt; Onboard2(Select Property &amp; Unit)\n    Onboard2 --&gt; Onboard3{Is Unit Vacant?}\n    Onboard3 --&gt;|No| OnboardErr(Display Error: Unit Occupied) --&gt; Dashboard\n    Onboard3 --&gt;|Yes| Onboard4(Set Base Rent &amp; Move-In Date)\n    Onboard4 --&gt; Onboard5(Update Unit Status to Occupied)\n    Onboard5 --&gt; Onboard6[(Save to PostgreSQL)]\n    Onboard6 --&gt; Dashboard\n\n    %% ==========================================\n    %% BRANCH 2: MONTHLY BILLING CYCLE\n    %% ==========================================\n    Dashboard --&gt;|Clicks Generate Bills| Bill1{Bills already exist&lt;br&gt;for month?}\n    Bill1 --&gt;|Yes| BillErr(Display Error: Bills Exist) --&gt; Dashboard\n    Bill1 --&gt;|No| Bill2(Retrieve Occupied Units)\n    Bill2 --&gt; Bill3(Enter Shared Utility Bills)\n    Bill3 --&gt; Bill4[[Execute Tenant Loop:&lt;br&gt;Rent + Utilities + Previous Due]]\n    Bill4 --&gt; Bill5(Generate PDF Invoices)\n    Bill5 --&gt; Bill6[(Save Invoices to PostgreSQL)]\n    Bill6 --&gt; Dashboard\n\n    %% ==========================================\n    %% BRANCH 3: PAYMENT PROCESSING\n    %% ==========================================\n    Dashboard --&gt;|Clicks Log Payment| Pay1(Select Tenant &amp; View Total Due)\n    Pay1 --&gt; Pay2(Enter Amount Paid by Tenant)\n    Pay2 --&gt; Pay3{Paid in Full?}\n    Pay3 --&gt;|Yes| Pay4(Mark Invoice as Fully Paid)\n    Pay3 --&gt;|No| Pay5(Mark Partial, Calc Remaining Balance)\n    Pay4 --&gt; Pay6[(Save Payment to PostgreSQL)]\n    Pay5 --&gt; Pay6\n    Pay6 --&gt; Pay7(Generate PDF Payment Receipt)\n    Pay7 --&gt; Dashboard\n\n    %% ==========================================\n    %% BRANCH 4: EXPENSE LOGGING\n    %% ==========================================\n    Dashboard --&gt;|Clicks Log Expense| Exp1(Enter Expense Details &amp; Amount)\n    Exp1 --&gt; Exp2{Is it for the Property&lt;br&gt;or a specific Unit?}\n    Exp2 --&gt;|Unit| Exp3(Link Expense to Unit)\n    Exp2 --&gt;|Property| Exp4(Link Expense to Whole Property)\n    Exp3 --&gt; Exp5[(Save Expense to PostgreSQL)]\n    Exp4 --&gt; Exp5\n    Exp5 --&gt; Dashboard\n\n    %% ==========================================\n    %% BRANCH 5: TENANT OFFBOARDING (MOVE-OUT)\n    %% ==========================================\n    Dashboard --&gt;|Clicks Move-Out| Out1(Select Tenant to Offboard)\n    Out1 --&gt; Out2(Check Unpaid Balances &amp; Log Repairs)\n    Out2 --&gt; Out3{Owes more than&lt;br&gt;Security Deposit?}\n    Out3 --&gt;|Yes| Out4(Generate Final Due Invoice)\n    Out3 --&gt;|No| Out5(Calculate Deposit Refund)\n    Out4 --&gt; Out6(Update Unit to Vacant)\n    Out5 --&gt; Out6\n    Out6 --&gt; Out7[(Archive Tenant in PostgreSQL)]\n    Out7 --&gt; Dashboard\n\n    %% ==========================================\n    %% EXIT SYSTEM\n    %% ==========================================\n    Dashboard --&gt;|Clicks Logout| Logout(End Session)\n    Logout --&gt; Stop([End System])\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0H9LiGGAq2wrDD5GKC_p-54">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
